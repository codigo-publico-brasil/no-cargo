# Modelo das variáveis de ambiente. Copie para `.env` (fora do git).
# Endereço base do datalake público (catalogo.duckdb e fotos). Vazio: usa o padrão do projeto
NO_CARGO_DATALAKE=
# Publicação no Cloudflare (scripts/publicar.sh). O token precisa de Workers Scripts: Edit na sua conta
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
