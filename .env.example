# Modelo das variáveis de ambiente. Copie para `.env` (fora do git).
# Endereço base do datalake público (catalogo.duckdb e fotos). Vazio: usa o padrão do projeto
NO_CARGO_DATALAKE=
# Publicação no Cloudflare Pages (scripts/publicar.sh). O token só precisa da permissão Cloudflare Pages: Edit
CF_PAGES_PROJETO=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
