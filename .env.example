# Modelo das variáveis de ambiente. Copie para `.env` (fora do git).
# Arquivo do warehouse da plataforma de dados (somente leitura).
NO_CARGO_WAREHOUSE=../dado-publico-brasil/data_store/warehouse.duckdb
# Fotos oficiais do TSE (<ano>/<UF>/<sequencial>.jpg), copiadas para o site; sem a pasta, o site gera sem elas
NO_CARGO_FOTOS=../dado-publico-brasil/data_store/fotos
